# Copy this file to ".env" in this same directory on the media/live-server host.
# getRecordedFile.php reads it at request time; it is not committed to the app tree,
# so upgrading/redeploying this directory does not overwrite your configuration.

# Absolute path where recorded .flv files are stored on this host.
RECORD_PATH=/var/www/tmp/

# Required shared secret. Requests must send it as ?secret=<value>.
# On the Streamer, set this server's "Get Remote File URL" in Live Servers to
# the HTTPS URL of getRecordedFile.php, including that secret query parameter.
# Each live server uses its own URL/secret. No HTTP transfer is needed when the
# Streamer can read the Nginx record_path directly (same host or shared volume).
# Leave empty to deny all requests (fail closed).
SECRET_KEY=
